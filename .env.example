# Copiar a .env y rellenar. Nunca commitear .env real (ver Reglas de trabajo del
# desarrollador único: "nunca copies credenciales a la bóveda" aplica también aquí).

APP_ENV=local
LOG_LEVEL=INFO

# Postgres de desarrollo. Coincide con el rol y la base que crea
# scripts/init-db.sql al levantar `docker compose up -d db`. En producción lo
# inyecta Railway como variable de entorno.
#
# `api_legal_app` NO es superusuario a propósito: un superusuario ignora los
# GRANT/REVOKE, y el audit log depende de un REVOKE. Ver README.
DATABASE_URL=postgresql+psycopg://api_legal_app:api_legal_app@localhost:5432/api_legal

# Base de datos de las pruebas. Si no se define, pytest usa este mismo valor por
# defecto. La suite se niega a arrancar si apunta a algo que parezca producción.
DATABASE_URL_TEST=postgresql+psycopg://api_legal_app:api_legal_app@localhost:5432/api_legal_test

# Usada desde T4 (sesión/JWT). Este valor de ejemplo vale para local y para CI, y NO
# sirve en producción: con APP_ENV=production, `app/core/config.py` se niega a arrancar
# si la clave es una de las de ejemplo o mide menos de 32 caracteres. No es un aviso,
# es una guarda — el deploy falla. Generar la real con
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
# y ponerla como variable de entorno en Railway, nunca en este repo ni en la bóveda.
SECRET_KEY=cambiar-en-produccion

# ¿`POST /v1/auth/registro` acepta altas de cualquiera? En F0, no: el piloto es un
# abogado y no hace falta autoservicio. Ese endpoint es público, sin sesión, y ejecuta
# bcrypt —caro por diseño—, así que abierto permite crear organizaciones ilimitadas y
# tumbar el único proceso de uvicorn con unas pocas peticiones concurrentes.
#
# Con `false` devuelve 403 sin tocar la base de datos. Las altas se hacen con:
#     python scripts/crear_organizacion.py --nombre "Bufete Infante" \
#         --slug bufete-infante --email juan.diego@example.com
#
# Hay rate-limit por IP en ese endpoint tanto si está abierto como si no.
REGISTRO_ABIERTO=false
