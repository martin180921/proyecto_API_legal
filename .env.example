# Copiar a .env y rellenar. Nunca commitear .env real (ver Reglas de trabajo del
# desarrollador único: "nunca copies credenciales a la bóveda" aplica también aquí).

APP_ENV=local
LOG_LEVEL=INFO

# Postgres local o el que dé Railway en producción. El valor por defecto en config.py
# apunta a un Postgres local de desarrollo — cámbialo aquí para tu máquina.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/api_legal

# Usada desde T4 (sesión/JWT). El default de config.py NO sirve en producción: generar
# una clave real antes de desplegar T4, y ponerla como variable de entorno en Railway,
# nunca en este repo.
SECRET_KEY=cambiar-en-produccion
