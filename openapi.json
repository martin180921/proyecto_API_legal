    },
    "/v1/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Ready",
        "description": "Confirma que el servicio puede hablar con Postgres, no solo que el\nproceso está vivo. Si la base no responde, devuelve 503 con un mensaje\ngenérico: este endpoint es público, así que ni la excepción de SQLAlchemy\nni nada de `DATABASE_URL` puede llegar al cuerpo de la respuesta — el\ndetalle va solo al log (regla de T4).",
        "operationId": "salud_lista",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
